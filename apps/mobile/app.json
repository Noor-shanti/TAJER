{
  "expo": {
    "name": "تبيين للمبيعات",
    "slug": "merchant-sales-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#0F172A"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0F172A"
      },
      "package": "com.merchant.salesapp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "merchant-sales-app"
      }
    },
    "plugins": [
      "expo-router",
      "expo-secure-store"
    ],
    "locales": {
      "ar": "./assets/locales/ar.json"
    }
  }
}
